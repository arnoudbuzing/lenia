  RowBox[{"(*", 
   RowBox[{"Example", " ", "Usage"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"Needs", "[", "\"\<Lenia`\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"grid", "=", 
     RowBox[{"LeniaSeed", "[", 
      RowBox[{"512", ",", "\"\<RandomOrganism\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Run", " ", "with", " ", "Rust", " ", "acceleration", " ", "and", " ", 
     "a", " ", "custom", " ", "kernel"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"history", "=", 
     RowBox[{"Lenia", "[", 
      RowBox[{"grid", ",", "1023", ",", 
       RowBox[{"\"\<LeniaKernel\>\"", "->", "\"\<Bump\>\""}], ",", 
