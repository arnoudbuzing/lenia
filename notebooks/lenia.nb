Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<Lenia`\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.983549396182646*^9, 3.9835494064445677`*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"6396ecbd-c251-4762-86fe-f055503d6abd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"gridSize", "=", 
   RowBox[{"{", 
    RowBox[{"256", ",", "256"}], "}"}]}], ";", 
  RowBox[{"R", "=", "13"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"grid", "=", 
   RowBox[{"N", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"r", "=", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"i", "-", "64"}], ")"}], "^", "2"}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"j", "-", "64"}], ")"}], "^", "2"}]}], "]"}], "/", 
           "R"}]}], "}"}], ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"r", "<", "1.0"}], ",", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"r", "-", "0.5"}], ")"}], "^", "2"}], ")"}]}], "/", 
            RowBox[{"(", 
             RowBox[{"2", "*", 
              RowBox[{"0.15", "^", "2"}]}], ")"}]}], "]"}], ",", "0.0"}], 
         "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "256"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "256"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"result", "=", 
   RowBox[{"Lenia", "[", 
    RowBox[{"grid", ",", "200", ",", 
     RowBox[{"\"\<Mu\>\"", "->", "0.15"}], ",", 
     RowBox[{"\"\<Sigma\>\"", "->", "0.015"}], ",", 
     RowBox[{"\"\<Radius\>\"", "->", "R"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"ArrayPlot", "[", 
  RowBox[{"result", ",", 
   RowBox[{"ColorFunction", "->", "\"\<SolarColors\>\""}]}], 
  "]"}], "\n"}], "Input",
 CellChangeTimes->{{3.983550392780326*^9, 3.983550420208931*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"dc55710b-680a-4e9c-be4e-6b35fcbbbb21"],

