Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sz", "=", "256"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gridSize", "=", 
   RowBox[{"{", 
    RowBox[{"sz", ",", "sz"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"R", "=", "13"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"grid", "=", 
    RowBox[{"N", "@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r", "=", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"i", "-", 
                 RowBox[{"sz", "/", "2.0"}]}], ")"}], "^", "2"}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"j", "-", 
                 RowBox[{"sz", "/", "2.0"}]}], ")"}], "^", "2"}]}], "]"}], "/",
             "R"}]}], "}"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"r", "<", "1.0"}], ",", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"r", "-", "0.5"}], ")"}], "^", "2"}], ")"}]}], "/", 
             RowBox[{"(", 
              RowBox[{"2", "*", 
               RowBox[{"0.15", "^", "2"}]}], ")"}]}], "]"}], ",", "0.0"}], 
          "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "sz"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "sz"}], "}"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"history", "=", 
    RowBox[{"Lenia", "[", 
     RowBox[{"grid", ",", "200", ",", 
      RowBox[{"\"\<ReturnHistory\>\"", "->", "True"}], ",", 
      RowBox[{"\"\<Radius\>\"", "->", "R"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"ListAnimate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"ArrayPlot", "[", 
     RowBox[{"#", ",", 
      RowBox[{"ColorFunction", "->", "\"\<SolarColors\>\""}], ",", 
      RowBox[{"Frame", "->", "False"}]}], "]"}], "&"}], "/@", "history"}], 
  "]"}], "\n"}], "Input",
 CellChangeTimes->{{3.9835505107139*^9, 3.9835505107140007`*^9}, {
  3.983550546452351*^9, 3.9835505803816032`*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"97537cc1-1907-40cf-be08-48aee5661eeb"],

