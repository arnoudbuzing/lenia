Notebook[{

Cell[CellGroupData[{
Cell["Lenia", "ObjectName",
 CellID->1139432764,ExpressionUUID->"3baedaa9-c2f0-48a6-b173-b570724fdff5"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5284d4df-789d-4a4e-b5ee-6b933aab9969"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Lenia",
    BaseStyle->"Link",
    ButtonData->"paclet:ArnoudBuzing/Lenia/ref/Lenia"], "[", 
   RowBox[{
    StyleBox["grid", "TI"], ",", 
    StyleBox["steps", "TI"], ",", 
    StyleBox["options", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "58cd2418-c1eb-45bf-af9d-b46ab08820b4"],
 " \[LineSeparator]runs the Lenia continuous cellular automaton for the given \
number of ",
 Cell[BoxData[
  StyleBox["steps", "TI"]], "InlineFormula",ExpressionUUID->
  "b97b27f3-acd8-4fc0-b10f-8d9f84fde282"],
 "."
}], "Usage",
 CellChangeTimes->{{3.983634904443995*^9, 3.983634941275412*^9}, {
  3.983635052816633*^9, 3.983635064574952*^9}},
 CellID->1334784249,ExpressionUUID->"a0ad8760-e0b4-49f6-acd4-bf14c4454748"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  StyleBox["grid", "TI"]], "InlineFormula",ExpressionUUID->
  "ad75a686-678f-43fc-8e90-e716122808c3"],
 " argument is a 2D matrix or NumericArray of real values between 0 and 1. It \
represents the initial state of the simulation."
}], "Notes",
 CellChangeTimes->{{3.983635004869986*^9, 3.983635036894616*^9}, {
  3.983635227086781*^9, 3.9836352675936737`*^9}},
 CellID->370439341,ExpressionUUID->"a852261f-6c4f-4f38-bc5c-1d3979ef6ee7"],

Cell["The following options are supported:", "Notes",
 CellChangeTimes->{{3.983635004869986*^9, 3.983635036894616*^9}, {
  3.983635227086781*^9, 3.983635286870142*^9}},
 CellID->715873362,ExpressionUUID->"87b885f7-c438-406c-911b-6dcacf497b04"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7c61ef37-4982-42b4-8d61-c8cf7b42ccb3"], "\"\<Mu\>\"", "0.15", Cell[
    "The center of the bell-shaped growth function ", "TableText",
     ExpressionUUID->"3673b5b0-d8da-4640-b613-3b7d804bf6ed"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d30ae587-ccc6-4364-bcdf-4f83accb1d45"], "\"\<Sigma\>\"", "0.015", Cell[
    "The width (standard deviation) of the growth function", "TableText",
     ExpressionUUID->"769df361-85a2-4354-98e9-1f14a682490e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "852e9897-8156-410b-b9e4-b3e5e72bea70"], "\"\<DT\>\"", "0.1", Cell["\<\
The time step for each iteration. Large values may cause instability.\
\>", "TableText",ExpressionUUID->"305deafc-7f7b-4b60-95a3-2468ac41a99b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b449ab1c-61dd-42d7-a80e-bcdbbaa2f907"], "\"\<Radius\>\"", "13", Cell[
    "The spatial radius of the kernel, measured in grid cells.", "TableText",
     ExpressionUUID->"6a799a0a-1b98-478f-921f-bc17256a14f0"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "fed5e274-9201-456f-92a9-bef5fa403200"], "\"\<ReturnHistory\>\"", 
    "False", Cell[TextData[{
     "If ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "a3dc80f4-cf03-4741-a9dd-04d6cd0836ea"],
     ", returns a ",
     Cell[BoxData[
      ButtonBox["NumericArray",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "dc9d489f-f0e6-4ff1-bbeb-d682f9236008"],
     " containing the grid at every step. If ",
     Cell[BoxData[
      ButtonBox["False",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "386298fc-f408-460d-87fc-f0f91c3d748b"],
     ", only returns the final grid."
    }], "TableText",ExpressionUUID->"bd9b5299-c885-498a-8a1a-9febae583ca7"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b7dd87a0-c212-477c-a9bd-0c379e568858"], "\"\<LeniaKernel\>\"", \
"\"\<Bump\>\"", Cell[
    "Specifies the kernel profile.", "TableText",ExpressionUUID->
     "e09f1ec0-4e59-486c-98fa-a4c67b45bb31"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "de746fa2-354c-422b-8547-6fb99c4c10c5"], "Method", "\"\<Wolfram\>\"", 
    Cell[TextData[{
     "The simulation backend. Use ",
     Cell[
     BoxData["\"\<Wolfram\>\""], "InlineFormula",ExpressionUUID->
      "24d0f15e-4950-492f-86b5-318873db8b9e"],
     " for the pure Wolfram Language implementation or ",
     Cell[
     BoxData["\"\<Rust\>\""], "InlineFormula",ExpressionUUID->
      "defeb41f-9502-45f9-861f-19527e9396b7"],
     " for the accelerated backend."
    }], "TableText",ExpressionUUID->"234f4dcf-4722-4638-aad8-92db745cd1c8"]}
  }]], "3ColumnTableMod",
 CellChangeTimes->{{3.983635389749456*^9, 3.983635573796885*^9}},
 CellID->343769845,ExpressionUUID->"4babf429-3bcc-45d7-9021-2ced79c24a3e"],

Cell[TextData[{
 "Possible pre-defined Lenia kernels include: ",
 Cell[BoxData["\"\<Bump\>\""], "InlineFormula",ExpressionUUID->
  "c55aa5a9-28d6-46d2-b358-def7c5d9c315"],
 ", ",
 Cell[BoxData["\"\<GaussianRing\>\""], "InlineFormula",ExpressionUUID->
  "455eb616-3422-4794-8c14-b54753bb1e48"],
 ", ",
 Cell[BoxData["\"\<StepRing\>\""], "InlineFormula",ExpressionUUID->
  "88d1f09a-7563-4ae1-8022-ce5ccc8a5e28"],
 ", ",
 Cell[BoxData["\"\<Polynomial\>\""], "InlineFormula",ExpressionUUID->
  "78cf6ac0-62e5-4982-9773-815bdc6c8161"],
 ", ",
 Cell[BoxData["\"\<SmoothLife\>\""], "InlineFormula",ExpressionUUID->
  "b7035793-c705-4392-a00e-045093341098"],
 ", and ",
 Cell[BoxData["\"\<Sharp\>\""], "InlineFormula",ExpressionUUID->
  "1ebe7169-5e2c-4625-a717-409aa889e88f"],
 "."
}], "Notes",
 CellChangeTimes->{{3.983635602339568*^9, 3.983635656883141*^9}},
